# ============================================================
# Normalizacion de finales de linea
#
# Los scripts .sh DEBEN quedar con LF, de lo contrario en Git Bash
# "./test-veterinaria.sh" falla con "bad interpreter: /bin/bash^M".
# ============================================================

*.sh         text eol=lf
*.ps1        text eol=crlf
*.java       text eol=lf
*.sql        text eol=lf
*.properties text eol=lf
*.xml        text eol=lf
*.md         text eol=lf
.gitattributes text eol=lf
